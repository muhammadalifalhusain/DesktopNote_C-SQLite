<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="DesktopNote.Views.NoteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DesktopNote.Converters"
    Title="Catatan Baru">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>

        <Grid.Resources>

            <converters:NoteColorTagToBrushConverter
                x:Key="NoteColorTagBrushConverter" />

            <SolidColorBrush
                x:Key="NoteTextBrush"
                Color="#2E2118" />

            <SolidColorBrush
                x:Key="NoteDividerBrush"
                Color="#332E2118" />

            <SolidColorBrush
                x:Key="TransparentBrush"
                Color="Transparent" />

            <SolidColorBrush
                x:Key="IconBlackBrush"
                Color="#000000" />

            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#2E2118" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#2E2118" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#2E2118" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#802E2118" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#802E2118" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#802E2118" />
            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>

            <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#14000000" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#1F000000" />
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="Transparent" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="Transparent" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#2E2118" />
            <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#2E2118" />
            <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#2E2118" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#2E2118" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#2E2118" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#000000" />
            <SolidColorBrush x:Key="ComboBoxFocusedDropDownGlyphForeground" Color="#000000" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#000000" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="#000000" />

            <SolidColorBrush x:Key="ButtonBackground" Color="#2E2118" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3D2E22" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1F150F" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonForeground" Color="White" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />

            <Style TargetType="TextBlock">
                <Setter
                    Property="FontFamily"
                    Value="{StaticResource AppFont}" />
                <Setter
                    Property="Foreground"
                    Value="{StaticResource NoteTextBrush}" />
            </Style>

            <Style x:Key="TypeComboBoxStyle" TargetType="ComboBox">
                <Setter
                    Property="FontFamily"
                    Value="{StaticResource AppFont}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="10,5,8,5" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style x:Key="TitleTextBoxStyle" TargetType="TextBox">
                <Setter
                    Property="FontFamily"
                    Value="{StaticResource AppFont}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,8" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="ContentTextBoxStyle" TargetType="TextBox">
                <Setter
                    Property="FontFamily"
                    Value="{StaticResource AppFont}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,8" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>

            <Style x:Key="SaveButtonStyle" TargetType="Button">
                <Setter
                    Property="FontFamily"
                    Value="{StaticResource AppFont}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="20,8" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ColorDotItemStyle" TargetType="ListViewItem">
                <Setter
                    Property="FontFamily"
                    Value="{StaticResource AppFont}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid
                                x:Name="Root"
                                Width="28"
                                Height="28"
                                Margin="0,0,4,0"
                                Background="Transparent">

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">

                                        <VisualState x:Name="Normal" />

                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="SelectionRing.Opacity" Value="0.3" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="SelectionRing.Opacity" Value="0.5" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="SelectionRing.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="SelectionRing.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="PressedSelected">
                                            <VisualState.Setters>
                                                <Setter Target="SelectionRing.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>

                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Ellipse
                                    x:Name="SelectionRing"
                                    Width="28"
                                    Height="28"
                                    Stroke="#000000"
                                    StrokeThickness="1.2"
                                    Opacity="0" />

                                <Ellipse
                                    Width="20"
                                    Height="20"
                                    Fill="{TemplateBinding Background}" />

                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </Grid.Resources>

        <Grid
            Padding="22,16,22,16"
            Background="{Binding ElementName=ColorComboBox, Path=SelectedItem.Tag, Converter={StaticResource NoteColorTagBrushConverter}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ComboBox
                x:Name="TypeComboBox"
                Grid.Row="0"
                Style="{StaticResource TypeComboBoxStyle}"
                SelectedIndex="0"
                HorizontalAlignment="Right"
                Margin="0,0,0,4"
                SelectionChanged="TypeComboBox_SelectionChanged">

                <ComboBoxItem Content="Catatan" />
                <ComboBoxItem Content="Task" />
                <ComboBoxItem Content="Reminder" />
                <ComboBoxItem Content="Checklist" />
                <ComboBoxItem Content="Ide" />
                <ComboBoxItem Content="Meeting" />

            </ComboBox>

            <TextBox
                x:Name="TitleTextBox"
                Grid.Row="1"
                Style="{StaticResource TitleTextBoxStyle}"
                PlaceholderText="Judul catatan"
                Foreground="Black"
                PlaceholderForeground="#66000000" />

            <Rectangle
                Grid.Row="2"
                Height="1"
                Fill="{StaticResource NoteDividerBrush}"
                Margin="0,4,0,6" />

            <TextBox
                x:Name="ContentTextBox"
                Grid.Row="3"
                Style="{StaticResource ContentTextBoxStyle}"
                PlaceholderText="Tulis catatan..."
                Foreground="Black"
                PlaceholderForeground="#66000000" />

            <StackPanel
                x:Name="DeadlinePanel"
                Grid.Row="4"
                Visibility="Collapsed"
                Spacing="8"
                Margin="0,12,0,0">

                <TextBlock
                    x:Name="DeadlineLabel"
                    Text="Tenggat"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Opacity="0.75" />

                <Grid ColumnSpacing="8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <CalendarDatePicker
                        x:Name="DeadlineDatePicker"
                        Grid.Column="0"
                        PlaceholderText="Pilih tanggal"
                        Background="Transparent"
                        BorderBrush="{StaticResource NoteDividerBrush}"
                        BorderThickness="1"
                        Foreground="{StaticResource NoteTextBrush}"
                        CornerRadius="10"
                        FontFamily="{StaticResource AppFont}" />

                    <TimePicker
                        x:Name="DeadlineTimePicker"
                        Grid.Column="1"
                        ClockIdentifier="24HourClock"
                        MinuteIncrement="1"
                        Background="Transparent"
                        BorderBrush="{StaticResource NoteDividerBrush}"
                        BorderThickness="1"
                        Foreground="{StaticResource NoteTextBrush}"
                        CornerRadius="10"
                        FontFamily="{StaticResource AppFont}" />

                </Grid>

                <TextBlock
                    x:Name="DeadlineValidationText"
                    Text="Tanggal dan jam wajib diisi."
                    FontSize="11"
                    Foreground="#C0392B"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

            </StackPanel>

            <Grid
                Grid.Row="5"
                Margin="0,16,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListView
                    x:Name="ColorComboBox"
                    Grid.Column="0"
                    SelectionMode="Single"
                    SelectedIndex="0"
                    Background="Transparent"
                    Padding="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    ItemContainerStyle="{StaticResource ColorDotItemStyle}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled">

                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListViewItem Tag="Butter" Background="#FFF8DC" ToolTipService.ToolTip="Butter" />
                    <ListViewItem Tag="Yellow" Background="#FFF3B0" ToolTipService.ToolTip="Yellow" />
                    <ListViewItem Tag="Green" Background="#D3EFC2" ToolTipService.ToolTip="Green" />
                    <ListViewItem Tag="Blue" Background="#C5E1F2" ToolTipService.ToolTip="Blue" />
                    <ListViewItem Tag="Purple" Background="#E1D2F0" ToolTipService.ToolTip="Purple" />
                    <ListViewItem Tag="Pink" Background="#F7D2E0" ToolTipService.ToolTip="Pink" />
                    <ListViewItem Tag="Orange" Background="#FFDCB4" ToolTipService.ToolTip="Orange" />
                    <ListViewItem Tag="Red" Background="#F5C8C8" ToolTipService.ToolTip="Red" />

                </ListView>

                <Button
                    Grid.Column="1"
                    Content="Simpan"
                    Style="{StaticResource SaveButtonStyle}"
                    Click="Save_Click" />

            </Grid>

        </Grid>

    </Grid>

</Window>
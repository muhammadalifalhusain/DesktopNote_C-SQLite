<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="DesktopNote.Views.ManagementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DesktopNote.Converters"
    Title="All Notes">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        Padding="24"
        RowSpacing="18">

        <Grid.Resources>

            <converters:NoteColorToBrushConverter
                x:Key="NoteColorConverter" />

            <converters:ReminderVisibilityConverter
                x:Key="ReminderVisibilityConverter" />

            <converters:DateTimeToStringConverter
                x:Key="DateTimeToStringConverter" />

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0">

            <StackPanel
                Spacing="4">

                <TextBlock
                    Text="All Notes"
                    FontSize="28"
                    FontWeight="SemiBold" />

                <TextBlock
                    Text="Kelola seluruh catatan Anda"
                    Opacity="0.65"
                    FontSize="13" />

            </StackPanel>

            <Button
                x:Name="NewNoteButton"
                Content="+ New Note"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="NewNote_Click" />

        </Grid>

        <StackPanel
            Grid.Row="1"
            Spacing="12">

            <TextBox
                x:Name="SearchTextBox"
                PlaceholderText="Cari catatan..."
                TextChanged="SearchTextBox_TextChanged" />

            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">

                    <Button
                        Content="All"
                        Tag="ALL"
                        Click="Filter_Click" />

                    <Button
                        Content="Note"
                        Tag="NOTE"
                        Click="Filter_Click" />

                    <Button
                        Content="Task"
                        Tag="TASK"
                        Click="Filter_Click" />

                    <Button
                        Content="Reminder"
                        Tag="RMNDR"
                        Click="Filter_Click" />

                    <Button
                        Content="Checklist"
                        Tag="CHKLST"
                        Click="Filter_Click" />

                    <Button
                        Content="Idea"
                        Tag="IDEA"
                        Click="Filter_Click" />

                    <Button
                        Content="Meeting"
                        Tag="MTING"
                        Click="Filter_Click" />

                </StackPanel>

            </ScrollViewer>

        </StackPanel>

        <Grid
            Grid.Row="2">

            <ListView
                x:Name="NotesList"
                SelectionMode="None"
                IsItemClickEnabled="False"
                BorderThickness="0"
                Padding="0">

                <ListView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="0,0,0,12"
                            Padding="18"
                            CornerRadius="12"
                            Background="{Binding Color, Converter={StaticResource NoteColorConverter}}">

                            <Grid
                                RowSpacing="10">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid
                                    Grid.Row="0">

                                    <TextBlock
                                        Text="{Binding Title}"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="Black"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Text="{Binding Type}"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="Black"
                                        Opacity="0.7" />

                                </Grid>

                                <TextBlock
                                    Grid.Row="1"
                                    Text="{Binding Content}"
                                    FontSize="13"
                                    Foreground="Black"
                                    TextWrapping="Wrap"
                                    MaxLines="4" />

                                <StackPanel
                                    Grid.Row="2"
                                    Orientation="Horizontal"
                                    Spacing="6">

                                    <TextBlock
                                        Text="Tenggat:"
                                        FontWeight="SemiBold"
                                        Foreground="Black"
                                        Visibility="{Binding ReminderAt, Converter={StaticResource ReminderVisibilityConverter}}" />

                                    <TextBlock
                                        Text="{Binding ReminderAt, Converter={StaticResource DateTimeToStringConverter}}"
                                        Foreground="Black"
                                        Visibility="{Binding ReminderAt, Converter={StaticResource ReminderVisibilityConverter}}" />

                                </StackPanel>

                                <StackPanel
                                    Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8">

                                    <Button
                                        Content="Edit"
                                        Tag="{Binding}"
                                        Click="EditNote_Click" />

                                    <Button
                                        Content="Delete"
                                        Tag="{Binding}"
                                        Click="DeleteNote_Click" />

                                </StackPanel>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ListView.ItemTemplate>

            </ListView>

            <TextBlock
                x:Name="EmptyTextBlock"
                Text="Belum ada catatan."
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="15"
                Opacity="0.6"
                Visibility="Collapsed" />

        </Grid>

    </Grid>

</Window>
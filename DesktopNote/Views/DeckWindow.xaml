<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="DesktopNote.Views.DeckWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DesktopNote.Converters"
    Title="DesktopNote">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="30">

        <Grid.Resources>
            <converters:NoteColorToBrushConverter
                x:Key="NoteColorConverter" />
        </Grid.Resources>

        <StackPanel Spacing="20">

            <TextBlock
                Text="DesktopNote"
                FontSize="32"
                FontWeight="SemiBold" />

            <TextBlock
                Text="Deck"
                FontSize="20" />

            <Button
                Content="+ New Note"
                Click="NewNote_Click"
                HorizontalAlignment="Left" />

            <ListView
                ItemsSource="{x:Bind ViewModel.Notes}">

                <ListView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Padding="15"
                            Margin="0,0,0,10"
                            CornerRadius="10"
                            Background="{Binding Color, Converter={StaticResource NoteColorConverter}}"
                            Tapped="Note_Tapped">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition
                                        Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="5">

                                    <TextBlock
                                        Text="{Binding Title}"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="Black" />

                                    <TextBlock
                                        Text="{Binding Content}"
                                        FontSize="14"
                                        TextWrapping="Wrap"
                                        Foreground="Black" />

                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    Content="📌"
                                    Click="Pin_Click"
                                    Tag="{Binding}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="Black"
                                    FontSize="18"
                                    VerticalAlignment="Top" />

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ListView.ItemTemplate>

            </ListView>

        </StackPanel>

    </Grid>

</Window>